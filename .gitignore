# Dependencies
node_modules/

# Frontend build (Vite)
dist/
dist-ssr/

# Rust / Tauri
src-tauri/target/
# Regenerated by tauri-build on every build — never hand-edited.
src-tauri/gen/schemas/
.tauri/

# Environment and secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE (local overrides only)
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agent / tooling local overrides (shared config stays tracked)
.claude/settings.local.json
.cursor/mcp.json
*.local

# Test and coverage output
coverage/
.vitest-cache/
test-results/
playwright-report/

# Temporary files
*.tmp
*.bak
*.orig
*.rej
